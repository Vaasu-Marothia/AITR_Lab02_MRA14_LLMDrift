# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/
*.ipynb~

# Models & large files (download via HuggingFace instead)
*.bin
*.safetensors
*.pt
*.pth

# Data (download via datasets library instead)
data/partitions/
data/raw/

# Results (generated by scripts)
results/*.jsonl
results/*.npy
results/*.csv
results/*.json
results/figures/*.png
results/figures/*.pdf

# Keep placeholders
!results/.gitkeep
!results/figures/.gitkeep

# Secrets & credentials
*.env
.env
secrets.json
api_keys.txt

# OS
.DS_Store
Thumbs.db
desktop.ini

# LaTeX build artefacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
# Keep the final PDF if present
!paper/*.pdf
